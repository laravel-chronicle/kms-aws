# -----------------------------------------------------------------------------
# Real-AWS test tier (composer test:aws) - OPT-IN, see CONTRIBUTING.md.
#
# `composer test` needs NONE of this: the default suite is fully mocked and
# zero-config. Copy this file to `.env` (gitignored) and fill it in only if you
# want to run the tiny live-KMS backstop against your own dedicated test keys.
#
# The keys are PRE-EXISTING and operator-managed. The tests never create, disable
# or schedule deletion of any key. Scope the IAM principal to just these two keys
# with kms:Sign, kms:Encrypt, kms:Decrypt, kms:DescribeKey.
# -----------------------------------------------------------------------------

# Set to 1 to opt in. When unset, the aws tier skips cleanly.
KMS_AWS_TESTS=1

# AWS credentials, scoped to the two test keys below. Read via the standard AWS
# SDK credential chain (env vars / IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

# Asymmetric ECC_NIST_P256 key, usage SIGN_VERIFY.
KMS_TEST_SIGNING_KEY_ARN=arn:aws:kms:eu-west-1:123456789012:key/00000000-0000-0000-0000-000000000000

# The signing key's public key. Either an inline PEM (use real newlines / a
# quoted multi-line value) or a path to a .pem file.
KMS_TEST_SIGNING_PUBLIC_KEY=/absolute/path/to/signing-public-key.pem

# Symmetric key, usage ENCRYPT_DECRYPT.
KMS_TEST_ENCRYPTION_KEY_ARN=arn:aws:kms:eu-west-1:123456789012:key/11111111-1111-1111-1111-111111111111

# Optional: a genuinely disabled or unauthorized key for the "fails loudly" test.
# When unset, the test uses a well-formed ARN with a non-existent key id instead.
# KMS_TEST_DENIED_KEY_ARN=
