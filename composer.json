{
  "name": "laravel-chronicle/kms-aws",
  "description": "AWS KMS signing adapter for the Chronicle audit ledger - remote sign, local verify.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "chronicle",
    "audit",
    "kms",
    "aws",
    "ecdsa",
    "signing"
  ],
  "authors": [
    {
      "name": "Vasileios Ntoufoudis",
      "email": "info@ntoufoudis.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-openssl": "*",
    "laravel-chronicle/core": "dev-feat/v1.10-key-rotation",
    "aws/aws-sdk-php": "^3.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Chronicle\\KmsAws\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Chronicle\\KmsAws\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Chronicle\\KmsAws\\KmsAwsServiceProvider"
      ]
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": true
      }
    }
  ],
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse --memory-limit=2G",
    "test": "vendor/bin/pest"
  }
}
