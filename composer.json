{
  "name": "laravel-chronicle/kms-aws",
  "description": "AWS KMS signing adapter for the Chronicle audit ledger - remote sign, local verify.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "chronicle",
    "audit",
    "kms",
    "aws",
    "ecdsa",
    "signing"
  ],
  "homepage": "https://github.com/laravel-chronicle/kms-aws",
  "support": {
    "email": "support@laravel-chronicle.dev",
    "issues": "https://github.com/laravel-chronicle/kms-aws/issues",
    "docs": "https://laravel-chronicle.dev"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ntoufoudis"
    }
  ],
  "authors": [
    {
      "name": "Vasileios Ntoufoudis",
      "email": "info@ntoufoudis.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-openssl": "*",
    "laravel-chronicle/core": "^1.12",
    "aws/aws-sdk-php": "^3.0"
  },
  "require-dev": {
    "laravel/pint": "^1.14",
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^10.0||^11.0",
    "pestphp/pest": "^3.0||^4.0",
    "pestphp/pest-plugin-laravel": "^3.0||^4.0"
  },
  "autoload": {
    "psr-4": {
      "Chronicle\\KmsAws\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Chronicle\\KmsAws\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Chronicle\\KmsAws\\KmsAwsServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "lint": "vendor/bin/pint",
    "test:lint": "vendor/bin/pint --test -v",
    "test:types": "vendor/bin/phpstan analyse",
    "test:unit": "vendor/bin/pest --exclude-group=aws",
    "test:aws": "vendor/bin/pest --group=aws",
    "test:all": "vendor/bin/pest",
    "test": [
      "@test:lint",
      "@test:types",
      "@test:unit"
    ]
  }
}
